{
  "name": "constitution-layer",
  "version": "0.3.0",
  "description": "由开发者确定项目红线与取舍，为编码智能体提供项目判断依据。支持 DeepSeek Harness、CodeBuddy/WorkBuddy、Claude Code 与 Codex。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/foundation.js",
    "cordis.patch.yml",
    "plugins/constitution-layer/**",
    ".codebuddy-plugin/marketplace.json",
    ".claude-plugin/marketplace.json",
    ".agents/plugins/marketplace.json",
    "CONSTITUTION.md",
    "MENTAL-MODEL.md",
    "README.md",
    "CHANGELOG.md",
    "evals/**",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "claude-code",
    "codex",
    "constitution",
    "mental-model",
    "decision-axes",
    "workflow",
    "skills"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-system-prompt": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  }
}
